// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USUARIO  @map("Usuário")
  OPERADOR @map("Operador")
  ADMIN    @map("Administrador")
}

enum EStatus {
  AGUARDANDO @map("Aguardando Autorização")
  AUTORIZADA @map("Autorizada")
  EXECUCAO   @map("Em Execução")
  FINALIZADA @map("Finalizada")
  CANCELADA  @map("Cancelada")
}

model User {
  id                   String          @id @default(uuid())
  name                 String
  email                String          @unique
  password             String
  phone                String?         @default("")
  area                 String?         @default("")
  funcao               String?         @default("")
  authorization        Boolean?        @default(false)
  role                 Role            @default(USUARIO)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  notifications        Notifications[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  amostra              Amostra[]
  OrdemServico         OrdemServico[]
}

model Notifications {
  id      Int     @id @default(autoincrement())
  title   String  @default("")
  message String  @default("")
  data    String  @default("")
  read    Boolean @default(false)
  userId  String
  user    User    @relation(fields: [userId], references: [id])
}

model TipoAnalise {
  id                  Int                   @id @default(autoincrement())
  tipo                String                @default("")
  classe              String                @default("")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  parametroAnalise    ParametrosAnalise[]
  configuracaoAnalise ConfiguracaoAnalise[]
  Amostra             Amostra?              @relation(fields: [amostraId], references: [id])
  amostraId           Int?
}

model ParametrosAnalise {
  id               Int                   @id @default(autoincrement())
  tipoAnaliseId    Int
  tipoAnalise      TipoAnalise           @relation(fields: [tipoAnaliseId], references: [id], onDelete: Cascade)
  descricao        String                @default("")
  unidadeMedida    String?               @default("")
  unidadeResultado String?               @default("")
  casasDecimais    Int                   @default(0)
  configuracoes    ConfiguracaoAnalise[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model ConfiguracaoAnalise {
  id            Int                 @id @default(autoincrement())
  nomeDescricao String
  tipoAnalise   TipoAnalise         @relation(fields: [tipoAnaliseId], references: [id], onDelete: Cascade)
  tipoAnaliseId Int
  parametros    ParametrosAnalise[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model MateriaPrima {
  id            Int      @id @default(autoincrement())
  nomeDescricao String   @default("")
  classeTipo    String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Amostra {
  id                 Int           @id @default(autoincrement())
  numeroOs           String
  ordemServico       OrdemServico  @relation(fields: [numeroOs], references: [id], onDelete: Cascade)
  nomeAmostra        String
  dataAmostra        String
  ensaiosSolicitados TipoAnalise[]
  amostraTipo        String        @default("Não definido")
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  resultados         Json?
  analistas          Json?
  status             EStatus       @default(AGUARDANDO)
  progresso          Int           @default(0)
  prazoInicioFim     String        @default("Aguardando")
  dataRecepcao       String        @default("Aguardando")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model OrdemServico {
  id             String    @id
  solicitanteId  String
  solicitante    User      @relation(fields: [solicitanteId], references: [id])
  amostras       Amostra[]
  status         EStatus   @default(AGUARDANDO)
  dataRecepcao   String    @default("")
  prazoInicioFim String    @default("")
  progresso      String?   @default("")
  observacao     String?   @default("")
  revisorId      String?   @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ElementoQuimico {
  id                  Int                @id @default(autoincrement())
  elementName         String             @default("")
  simbolo             String             @default("")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  AmostraLabExterno   AmostraLabExterno[]
}

model LaboratorioExterno {
  id        Int                 @id @default(autoincrement())
  nome      String
  endereco  Json
  telefone  String?             @default("")
  email     String?             @default("")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  Remessa   RemessaLabExterno[]
}

model AmostraLabExterno {
  id                     Int               @id @default(autoincrement())
  amostraName            String
  elementosAnalisados ElementoQuimico[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model RemessaLabExterno {
  id        Int                     @id @default(autoincrement())
  data      String
  destinoId Int
  destino   LaboratorioExterno      @relation(fields: [destinoId], references: [id])
  amostras  AmostraAnaliseExterna[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model AmostraAnaliseExterna {
  id                   Int               @id @default(autoincrement())
  amostraName          String
  subIdentificacao     String?           @default("")
  dataInicio           String
  dataFim              String
  elementosSolicitados Json
  elementosAnalisados  Json?
  analiseConcluida     Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  RemessaLabExterno    RemessaLabExterno @relation(fields: [remessaLabExternoId], references: [id])
  remessaLabExternoId  Int
}
