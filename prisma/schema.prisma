generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String          @id @default(uuid())
  name                 String
  email                String          @unique
  password             String
  phone                String          @default("")
  area                 String          @default("")
  funcao               String          @default("")
  authorization        Boolean         @default(false)
  role                 Role            @default(USUARIO)
  receives_email       Boolean         @default(true)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  amostra              Amostra[]
  notifications        Notifications[]
  OrdemServico         OrdemServico[]
}

model Notifications {
  id      Int      @id @default(autoincrement())
  title   String   @default("")
  message String   @default("")
  data    DateTime @default(now())
  read    Boolean  @default(false)
  userId  String
  user    User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "Notifications_userId_fkey")
}

model TipoAnalise {
  id                  Int                   @id @default(autoincrement())
  tipo                String                @default("")
  classe              String                @default("")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  configuracaoAnalise ConfiguracaoAnalise[]
  parametroAnalise    ParametrosAnalise[]
  Amostra             Amostra[]             @relation("AmostraToTipoAnalise")
}

model ParametrosAnalise {
  id               Int                   @id @default(autoincrement())
  tipoAnaliseId    Int
  descricao        String                @default("")
  subDescricao     String                @default("")
  unidadeResultado String                @default("")
  casasDecimais    Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tipoAnalise      TipoAnalise           @relation(fields: [tipoAnaliseId], references: [id], onDelete: Cascade)
  configuracoes    ConfiguracaoAnalise[] @relation("ConfiguracaoAnaliseToParametrosAnalise")

  @@index([tipoAnaliseId], map: "ParametrosAnalise_tipoAnaliseId_fkey")
}

model ConfiguracaoAnalise {
  id            Int                 @id @default(autoincrement())
  nomeDescricao String
  tipoAnaliseId Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tipoAnalise   TipoAnalise         @relation(fields: [tipoAnaliseId], references: [id], onDelete: Cascade)
  parametros    ParametrosAnalise[] @relation("ConfiguracaoAnaliseToParametrosAnalise")

  @@index([tipoAnaliseId], map: "ConfiguracaoAnalise_tipoAnaliseId_fkey")
}

model MateriaPrima {
  id            Int      @id @default(autoincrement())
  nomeDescricao String   @default("")
  classeTipo    String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Amostra {
  id                 Int           @id @default(autoincrement())
  numeroOs           String
  nomeAmostra        String
  dataAmostra        String
  amostraTipo        String        @default("Não definido")
  userId             String
  resultados         Json?
  analistas          Json?
  revisor            String?       @default("")
  status             EStatus       @default(AGUARDANDO)
  progresso          Int           @default(0)
  prazoInicioFim     String        @default("")
  dataRecepcao       String        @default("")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  ordemServico       OrdemServico  @relation(fields: [numeroOs], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id])
  ensaiosSolicitados TipoAnalise[] @relation("AmostraToTipoAnalise")

  @@index([numeroOs], map: "Amostra_numeroOs_fkey")
  @@index([userId], map: "Amostra_userId_fkey")
}

model OrdemServico {
  id             String    @id
  solicitanteId  String
  status         EStatus   @default(AGUARDANDO)
  dataRecepcao   String    @default("")
  prazoInicioFim String    @default("")
  progresso      Int       @default(0)
  observacao     String    @default("")
  revisorId      String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  amostras       Amostra[]
  solicitante    User      @relation(fields: [solicitanteId], references: [id])

  @@index([solicitanteId], map: "OrdemServico_solicitanteId_fkey")
}

model ElementoQuimico {
  id                Int                 @id @default(autoincrement())
  elementName       String              @default("")
  simbolo           String              @default("")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  AmostraLabExterno AmostraLabExterno[] @relation("AmostraLabExternoToElementoQuimico")
}

model LaboratorioExterno {
  id        Int                 @id @default(autoincrement())
  nome      String
  endereco  Json
  telefone  String              @default("")
  email     String              @default("")
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  Remessa   RemessaLabExterno[]
}

model AmostraLabExterno {
  id                  Int               @id @default(autoincrement())
  amostraName         String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  elementosAnalisados ElementoQuimico[] @relation("AmostraLabExternoToElementoQuimico")
}

model RemessaLabExterno {
  id        Int                     @id @default(autoincrement())
  data      String
  destinoId Int
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  amostras  AmostraAnaliseExterna[]
  destino   LaboratorioExterno      @relation(fields: [destinoId], references: [id])

  @@index([destinoId], map: "RemessaLabExterno_destinoId_fkey")
}

model AmostraAnaliseExterna {
  id                   Int               @id @default(autoincrement())
  amostraName          String
  subIdentificacao     String            @default("")
  dataInicio           String
  dataFim              String
  elementosSolicitados Json
  elementosAnalisados  Json?
  analiseConcluida     Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  remessaLabExternoId  Int
  RemessaLabExterno    RemessaLabExterno @relation(fields: [remessaLabExternoId], references: [id], onDelete: Cascade)

  @@index([remessaLabExternoId], map: "AmostraAnaliseExterna_remessaLabExternoId_fkey")
}

enum Role {
  USUARIO  @map("Usuário")
  OPERADOR @map("Operador")
  ADMIN    @map("Administrador")
}

enum EStatus {
  AGUARDANDO @map("Aguardando Autorização")
  AUTORIZADA @map("Autorizada")
  EXECUCAO   @map("Em Execução")
  FINALIZADA @map("Finalizada")
  CANCELADA  @map("Cancelada")
}
