// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USUARIO  @map("Usuário")
  OPERADOR @map("Operador")
  ADMIN    @map("Administrador")
}

model User {
  id                   String          @id @default(uuid())
  name                 String
  email                String          @unique
  password             String
  phone                String?         @default("")
  area                 String?         @default("")
  funcao               String?         @default("")
  authorization        Boolean?        @default(false)
  role                 Role            @default(USUARIO)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  notifications        Notifications[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  amostra              Amostra[]
  OrdemServico         OrdemServico[]
}

model Notifications {
  id      Int     @id @default(autoincrement())
  title   String  @default("")
  message String  @default("")
  data    String  @default("")
  read    Boolean @default(false)
  userId  String
  user    User    @relation(fields: [userId], references: [id])
}

model TipoAnalise {
  id                  Int                   @id @default(autoincrement())
  tipo                String                @default("")
  classe              String                @default("")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  parametroAnalise    ParametrosAnalise[]
  configuracaoAnalise ConfiguracaoAnalise[]
}

model ParametrosAnalise {
  id            Int                   @id @default(autoincrement())
  tipoAnaliseId Int
  tipoAnalise   TipoAnalise           @relation(fields: [tipoAnaliseId], references: [id])
  unidadeMedida String?               @default("")
  descricao     String                @default("")
  configuracoes ConfiguracaoAnalise[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model ConfiguracaoAnalise {
  id             Int                 @id @default(autoincrement())
  tipoAnalise    TipoAnalise         @relation(fields: [tipoAnaliseId], references: [id])
  tipoAnaliseId  Int
  materiaPrima   MateriaPrima        @relation(fields: [materiaPrimaId], references: [id])
  materiaPrimaId Int
  parametros     ParametrosAnalise[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model MateriaPrima {
  id                  Int                   @id @default(autoincrement())
  nome_descricao      String                @default("")
  classe_tipo         String                @default("")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  configuracaoAnalise ConfiguracaoAnalise[]
}

model Amostra {
  id                 Int          @id @default(autoincrement())
  numeroOs           String
  ordemServico       OrdemServico @relation(fields: [numeroOs], references: [id])
  nomeAmostra        String
  dataAmostra        String       
  ensaiosSolicitados Json?
  amostraTipo        String?      @default("Não definido")
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  resultados         Json?
  analistas          Json?
  status             EStatus      @default(AGUARDANDO)
  progresso          Int          @default(0)
  prazoInicioFim     String?      @default("Aguardando")
  dataRecepcao       String?      @default("Aguardando")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

enum EStatus {
  AGUARDANDO @map("Aguardando Autorização")
  AUTORIZADA @map("Autorizada")
  EXECUCAO   @map("Em Execução")
  FINALIZADA @map("Finalizada")
  CANCELADA  @map("Cancelada")
}

model OrdemServico {
  id             String    @id
  numeroOs       String
  solicitanteId  String
  solicitante    User      @relation(fields: [solicitanteId], references: [id])
  amostras       Amostra[]
  status         String    @default("")
  dataRecepcao   String    @default("")
  prazoInicioFim String    @default("")
  progresso      String?   @default("")
  observacao     String?   @default("")
  revisorId      String?   @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
